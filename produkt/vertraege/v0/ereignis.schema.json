{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chnobel.local/vertraege/ereignis.schema.json",
  "title": "Ereignis des Beobachtungsprotokolls",
  "description": "Hülle und Typkatalog. Startversion v0; typgebundene Payload-Schemas in Phase 0 ergänzen.",
  "type": "object",
  "required": ["type", "schemaVersion", "eventId", "streamId", "seq", "occurredAt", "actor", "candidate", "payload"],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "attempt.opened", "attempt.closed",
        "input.captured", "recognition.proposed",
        "answer.committed", "response.retracted",
        "material.moved", "action.undone",
        "support.presented", "mode.changed",
        "artifact.saved", "self_report.recorded",
        "condition.observed",
        "content.withdrawn", "observation.invalidated", "artifact.deleted", "profile.erasure_requested"
      ]
    },
    "schemaVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "eventId": {"type": "string", "format": "uuid"},
    "streamId": {"type": "string", "description": "Versuchsstream; bei attempt.opened einem lokalen Profil zugeordnet"},
    "seq": {"type": "integer", "minimum": 0},
    "occurredAt": {"type": "string", "format": "date-time"},
    "monotonic": {
      "type": "object",
      "required": ["bootId", "ns"],
      "additionalProperties": false,
      "properties": {"bootId": {"type": "string"}, "ns": {"type": "integer", "minimum": 0}}
    },
    "actor": {"type": "string", "enum": ["child", "app", "system"]},
    "candidate": {
      "type": "object",
      "required": ["build", "content"],
      "additionalProperties": false,
      "properties": {
        "build": {"type": "string"},
        "content": {"type": "string"},
        "rules": {"type": "string"},
        "model": {"type": "string"}
      }
    },
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "answer.committed"}}},
      "then": {"properties": {"payload": {
        "type": "object",
        "required": ["answerId", "value", "origin"],
        "properties": {
          "answerId": {"type": "string"},
          "value": {},
          "origin": {"type": "string", "enum": ["direkt", "automatisch_uebernommen", "bestaetigt", "korrigiert"]},
          "fromRecognitionId": {"type": "string"}
        }
      }}}
    },
    {
      "if": {"properties": {"type": {"const": "material.moved"}}},
      "then": {"properties": {"payload": {
        "type": "object",
        "required": ["moveId", "items", "fromZone", "toZone", "via"],
        "properties": {
          "moveId": {"type": "string"},
          "items": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "fromZone": {"type": "string"},
          "toZone": {"type": "string"},
          "via": {"type": "string", "enum": ["ziehen", "antippen_ablegen", "tastatur", "voiceover", "schaltersteuerung", "app_demo"]}
        }
      }}}
    },
    {
      "if": {"properties": {"type": {"const": "support.presented"}}},
      "then": {"properties": {"payload": {
        "type": "object",
        "required": ["supportId", "kind", "target", "channel"],
        "properties": {
          "supportId": {"type": "string"},
          "kind": {"type": "string", "enum": ["aufmerksamkeit", "teilschritt", "loesungsweg", "vorlesen", "demo"]},
          "target": {"type": "string", "description": "Betroffenes Lernziel/Faktum, z.B. ten.step"},
          "channel": {"type": "string", "enum": ["visuell", "audio", "voiceover", "haptik"]}
        }
      }}}
    },
    {
      "if": {"properties": {"type": {"const": "recognition.proposed"}}},
      "then": {"properties": {"payload": {
        "type": "object",
        "required": ["recognitionId", "inputId", "reading", "confidence"],
        "properties": {
          "recognitionId": {"type": "string"},
          "inputId": {"type": "string"},
          "reading": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "alternatives": {"type": "array", "items": {"type": "string"}}
        }
      }}}
    }
  ]
}
