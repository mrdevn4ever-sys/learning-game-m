{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chnobel.local/vertraege/beweisregel.schema.json",
  "title": "Beweisregel",
  "description": "Eine Regel erlaubt genau eine fachliche Aussage. Startversion v0; in Phase 0 zu v1 verfeinern.",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "claimId", "target", "applicability", "logic", "boundary"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9_-]+)*$"},
    "version": {"type": "integer", "minimum": 1},
    "claimId": {"type": "string"},
    "target": {
      "type": "object",
      "required": ["references"],
      "additionalProperties": false,
      "properties": {
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["kanton", "schulsprache", "code", "stufe", "ausgabe", "taetigkeit", "bezug"],
            "additionalProperties": false,
            "properties": {
              "kanton": {"type": "string", "enum": ["LU", "BE"]},
              "schulsprache": {"type": "string", "enum": ["de"]},
              "code": {"type": "string", "description": "Kompetenzcode, z.B. MA.1.C.1"},
              "stufe": {"type": "string", "description": "Kompetenzstufe, z.B. b"},
              "ausgabe": {"type": "string", "description": "Lehrplanfassung/Ausgabe mit Datum"},
              "url": {"type": "string", "format": "uri"},
              "abgerufen": {"type": "string", "format": "date"},
              "taetigkeit": {"type": "string", "description": "Beobachtbare Tätigkeit innerhalb der Stufe (eigene Formulierung)"},
              "bezug": {"type": "string", "enum": ["teil", "voll"]}
            }
          }
        }
      }
    },
    "applicability": {
      "type": "object",
      "required": ["taskContracts", "startingStates", "scope", "nachweisform"],
      "additionalProperties": false,
      "properties": {
        "taskContracts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "startingStates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "scope": {"type": "string", "enum": ["einzelversuch", "mehrere_versuche"]},
        "nachweisform": {
          "type": "string",
          "enum": ["antwort", "dargestellter_weg", "werkstueck", "selbstauskunft", "aufnahme", "planung"]
        },
        "beobachtungsfenster": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minAbstandStunden": {"type": "number", "minimum": 0},
            "maxAbstandTage": {"type": "number", "minimum": 0},
            "zeitVerlaesslichErforderlich": {"type": "boolean"}
          }
        }
      }
    },
    "logic": {
      "type": "object",
      "required": ["factCatalogVersion", "requires", "unknownPolicy"],
      "additionalProperties": false,
      "properties": {
        "factCatalogVersion": {"type": "string"},
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "all": {"type": "array", "items": {"type": "string"}, "description": "Fakten, die als WAHR belegt sein müssen"},
            "none": {"type": "array", "items": {"type": "string"}, "description": "Fakten, die als FALSCH belegt sein müssen (unbekannt genügt nicht)"}
          }
        },
        "unknownPolicy": {"type": "string", "enum": ["fallback"], "description": "Ist ein benötigtes Faktum unbekannt, entfällt die Aussage und der Rückfall greift"}
      }
    },
    "boundary": {
      "type": "object",
      "required": ["alternatives", "counterexamples", "wording"],
      "additionalProperties": false,
      "properties": {
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["erklaerung"],
            "additionalProperties": false,
            "properties": {
              "erklaerung": {"type": "string"},
              "ausschlussFakt": {"type": "string"}
            }
          }
        },
        "counterexamples": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["traceRef", "expected"],
            "additionalProperties": false,
            "properties": {
              "traceRef": {"type": "string"},
              "expected": {"type": "string", "enum": ["must_claim", "must_not_claim", "undecidable"]}
            }
          }
        },
        "wording": {
          "type": "object",
          "required": ["de-CH", "fallback"],
          "additionalProperties": false,
          "properties": {
            "de-CH": {"type": "string"},
            "kind": {"type": "string", "description": "Optionaler kindgerechter Text ohne Prüfetiketten"},
            "fallback": {"type": "string", "description": "claimId einer engeren Aussage oder 'insufficient_observation'"}
          }
        }
      }
    }
  }
}
